# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port (default: 3000)
PORT=3000

# Frontend Configuration
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
VITE_APP_BASE_PATH="/ai-research/"

# Backend / Supabase Configuration
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# GitHub App / OAuth Configuration
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"
GITHUB_APP_ID="your-github-app-id"
GITHUB_PRIVATE_KEY="your-github-private-key"
GITHUB_WEBHOOK_SECRET="your-github-webhook-secret"
GITHUB_PERSONAL_ACCESS_TOKEN=""

# Default Organization Repo
GITHUB_REPO_OWNER="we-do-care-global"
GITHUB_REPO_NAME="we-do-care-global"

# AI & Search Providers
# OPENAI_API_KEY=  # Optional: set securely in deployment environment
ANTHROPIC_API_KEY=""
TAVILY_API_KEY=""
SERPER_API_KEY=""
BRAVE_API_KEY=""

# Daily Auto-Expansion Cron & Timezone
DAILY_RESEARCH_CRON="0 8 * * *"
DAILY_RESEARCH_TZ="Europe/Sarajevo"
EVENING_RESEARCH_CRON="0 20 * * *"
NOTIFICATION_EMAIL_FROM="notifications@example.invalid"
